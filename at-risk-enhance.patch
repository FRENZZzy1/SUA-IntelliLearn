+/* =====================================================================
+   At-Risk Students — enhancement layer (loads AFTER at_risk_students.css)
+   Adds Uriel's insights header + purposeful motion. The original layout
+   (grade > section > course > roster table) is left exactly as it was.
+   Delete the <link> to this file to switch everything off.
+   ===================================================================== */
+.ar-wrap, .ai-modal {
+    --arx-green-900: var(--primary-dark, #10281e);
+    --arx-green-800: var(--primary, #1b4332);
+    --arx-green-700: var(--primary-light, #2d6a4f);
+    --arx-gold: var(--accent, #f4a300);
+    --arx-ease: cubic-bezier(.2,.8,.2,1);
+}
+
+/* ---------- Shared motion ---------- */
+@keyframes arxRise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
+@keyframes arxFill { from { width: 0; } }
+@keyframes arxShimmer { to { background-position: -200% 0; } }
+@keyframes arxPulse { 0%,100% { box-shadow: 0 0 0 0 rgba(220,38,38,.45); } 60% { box-shadow: 0 0 0 6px rgba(220,38,38,0); } }
+.arx-seq { opacity: 0; animation: arxRise .34s var(--arx-ease) forwards; animation-delay: calc(var(--d, 0) * 70ms); }
+
+/* ---------- Existing stat cards: counters, lift, accent ---------- */
+.ar-summary .ar-stat { position: relative; overflow: hidden; animation: arxRise .34s var(--arx-ease) both; animation-delay: calc(var(--i, 0) * 70ms);
+    transition: transform .18s var(--arx-ease), box-shadow .18s; }
+.ar-summary .ar-stat::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 4px; background: #9ca3af; }
+.ar-summary .ar-stat.high::before { background: #dc2626; } .ar-summary .ar-stat.medium::before { background: #d97706; }
+.ar-summary .ar-stat.low::before { background: #16a34a; } .ar-summary .ar-stat.na::before { background: #9ca3af; }
+.ar-summary .ar-stat:hover { transform: translateY(-3px); box-shadow: 0 10px 22px rgba(16,40,30,.12); }
+.ar-summary .ar-stat .n { font-variant-numeric: tabular-nums; }
+.ar-summary.arx-loading .ar-stat .n { color: transparent !important; border-radius: 6px; width: 2.2ch; min-height: 1.5em;
+    background: linear-gradient(90deg, #e8eeea 25%, #f6f9f7 50%, #e8eeea 75%); background-size: 200% 100%; animation: arxShimmer 1.2s linear infinite; }
+
+/* ---------- Uriel mascot ---------- */
+.uriel { --sz: 72px; position: relative; width: var(--sz); height: var(--sz); flex: 0 0 auto; }
+.uriel.lg { --sz: 116px; } .uriel.md { --sz: 68px; }
+.uriel-photo { position: absolute; inset: 0; border-radius: 50%; overflow: hidden; background: #fbf3dc; border: 3px solid var(--arx-gold); box-shadow: 0 8px 22px rgba(0,0,0,.28); animation: urFloat 4.2s ease-in-out infinite; transform-origin: 50% 80%; }
+.uriel.md .uriel-photo { border-width: 2px; box-shadow: 0 4px 12px rgba(16,40,30,.2); }
+.uriel-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 35%; display: block; pointer-events: none; user-select: none; }
+.uriel-ring { position: absolute; inset: -9px; border-radius: 50%; opacity: 0; pointer-events: none; background: conic-gradient(from 0deg, transparent 0 62%, rgba(244,163,0,.85) 100%);
+    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 4px), #000 calc(100% - 3px)); mask: radial-gradient(farthest-side, transparent calc(100% - 4px), #000 calc(100% - 3px)); }
+.uriel-badge { position: absolute; right: -4px; bottom: -2px; width: 32%; height: 32%; min-width: 22px; min-height: 22px; border-radius: 50%; display: grid; place-items: center; z-index: 2;
+    background: var(--arx-gold); color: var(--arx-green-900); font-size: calc(var(--sz) * .15); border: 2px solid #fff; animation: urPop .4s var(--arx-ease) both; box-shadow: 0 3px 8px rgba(0,0,0,.25); }
+.uriel.md .uriel-badge { font-size: 10px; }
+.uriel-spark { position: absolute; width: 10px; height: 10px; background: var(--arx-gold); clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%); opacity: 0; }
+.uriel-spark.s1 { top: -4px; left: 6px; } .uriel-spark.s2 { top: 14px; right: -10px; width: 8px; height: 8px; } .uriel-spark.s3 { bottom: 14px; left: -12px; width: 7px; height: 7px; }
+.uriel.md .uriel-spark { display: none; }
+@keyframes urFloat { 0%,100% { transform: translateY(0) scale(1); } 50% { transform: translateY(-5px) scale(1.025); } }
+@keyframes urSpin { to { transform: rotate(360deg); } }
+@keyframes urPop { from { transform: scale(0) rotate(-40deg); } to { transform: scale(1); } }
+@keyframes urWiggle { 0%,100% { transform: rotate(0); } 25% { transform: rotate(-4deg); } 75% { transform: rotate(4deg); } }
+@keyframes urWave { 0% { transform: rotate(0); } 18% { transform: rotate(-12deg); } 36% { transform: rotate(10deg); } 54% { transform: rotate(-7deg); } 72% { transform: rotate(4deg); } 100% { transform: rotate(0); } }
+@keyframes urTwinkle { 0%,100% { opacity: 0; transform: scale(.4); } 50% { opacity: 1; transform: scale(1); } }
+@keyframes urBounce { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
+.uriel[data-state="scanning"] .uriel-ring, .uriel[data-state="thinking"] .uriel-ring { opacity: 1; animation: urSpin 1.1s linear infinite; }
+.uriel[data-state="scanning"] .uriel-photo { animation: urWiggle 1.2s ease-in-out infinite; }
+.uriel[data-state="scanning"] .uriel-badge { animation: urBounce .8s ease-in-out infinite; }
+.uriel[data-state="concern"] .uriel-badge { background: #fff3cd; color: #b45309; }
+.uriel[data-state="calm"] .uriel-photo { animation-duration: 5.2s; }
+.uriel[data-state="calm"] .uriel-badge { background: #d7f5e3; color: #15803d; }
+.uriel[data-state="calm"] .uriel-spark { animation: urTwinkle 2.4s ease-in-out infinite; }
+.uriel[data-state="calm"] .uriel-spark.s2 { animation-delay: .8s; } .uriel[data-state="calm"] .uriel-spark.s3 { animation-delay: 1.5s; }
+.uriel[data-state="insufficient"] .uriel-badge, .uriel[data-state="empty"] .uriel-badge { background: #e9eeeb; color: #5b6b63; }
+.uriel.wave .uriel-photo { animation: urWave 1.2s ease-in-out 1, urFloat 4.2s ease-in-out 1.2s infinite; }
+.uriel.wave .uriel-spark { animation: urTwinkle 1.2s ease-in-out 2; }
+
+/* ---------- Insights header banner ---------- */
+.ar-insight { position: relative; margin: 0 0 20px; border-radius: 18px; overflow: hidden; color: #fff;
+    background: linear-gradient(135deg, var(--arx-green-900), var(--arx-green-800) 58%, var(--arx-green-700)); border-bottom: 4px solid var(--arx-gold); box-shadow: 0 14px 34px rgba(16,40,30,.22); }
+.ar-insight:empty { display: none; }
+.ar-insight::after { content: ""; position: absolute; right: -60px; top: -60px; width: 220px; height: 220px; border-radius: 50%; background: radial-gradient(circle, rgba(244,163,0,.22), transparent 68%); pointer-events: none; }
+.ins-inner { position: relative; z-index: 1; display: grid; grid-template-columns: auto 1fr; gap: 24px; padding: 24px 28px; align-items: start; }
+.ins-mascot { padding: 10px 8px 0; }
+.ins-head { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 10px; }
+.ins-title { font-weight: 800; font-size: .95rem; letter-spacing: .02em; display: inline-flex; gap: 8px; align-items: center; color: #ffe08a; }
+.ins-scope { font-size: .74rem; padding: 3px 10px; border-radius: 99px; background: rgba(255,255,255,.12); color: rgba(255,255,255,.9); }
+.ins-again { margin-left: auto; border: 1px solid rgba(255,255,255,.3); background: rgba(255,255,255,.08); color: #fff; border-radius: 99px; padding: 5px 12px; font-size: .76rem; font-weight: 600; cursor: pointer; display: inline-flex; gap: 6px; align-items: center; font-family: inherit; transition: background .15s; }
+.ins-again:hover { background: rgba(255,255,255,.2); } .ins-again:hover i { animation: urSpin .6s linear; }
+.ins-hello { margin: 0 0 14px; font-size: .95rem; color: rgba(255,255,255,.9); line-height: 1.5; max-width: 70ch; }
+.ins-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 18px; align-items: start; }
+.ins-rows { display: flex; flex-direction: column; gap: 10px; }
+.ins-row { display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; border-radius: 12px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.1); }
+.ins-row.overview { background: rgba(255,255,255,.14); } .ins-row.action { background: rgba(244,163,0,.18); border-color: rgba(244,163,0,.5); }
+.ins-ic { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: rgba(255,255,255,.14); color: #ffe08a; flex: 0 0 auto; font-size: .9rem; }
+.ins-row.action .ins-ic { background: var(--arx-gold); color: var(--arx-green-900); }
+.ins-lbl { display: block; font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; color: rgba(255,255,255,.65); margin-bottom: 2px; }
+.ins-row p { margin: 0; font-size: .92rem; line-height: 1.45; } .ins-row p.ins-big { font-size: 1.15rem; font-weight: 700; }
+.arx-btn { margin-top: 10px; display: inline-flex; align-items: center; gap: 8px; border: 0; border-radius: 999px; padding: 8px 16px; font-size: .8rem; font-weight: 700; cursor: pointer; font-family: inherit;
+    background: var(--arx-gold); color: var(--arx-green-900); transition: background .18s, transform .12s; }
+.arx-btn:hover { background: #ffb81f; } .arx-btn:active { transform: scale(.97); }
+.ins-drivers { padding: 14px 16px; border-radius: 12px; background: rgba(0,0,0,.18); }
+.ins-drivers h4 { margin: 0 0 10px; font-size: .74rem; text-transform: uppercase; letter-spacing: .08em; color: rgba(255,255,255,.7); }
+.drv { display: grid; grid-template-columns: minmax(96px, auto) 1fr 24px; gap: 10px; align-items: center; margin-bottom: 9px; font-size: .8rem; } .drv:last-child { margin-bottom: 0; }
+.drv-l { display: inline-flex; gap: 7px; align-items: center; } .drv-l i { color: #ffe08a; width: 14px; text-align: center; }
+.drv-bar { height: 8px; border-radius: 99px; background: rgba(255,255,255,.14); overflow: hidden; }
+.drv-bar span { display: block; height: 100%; width: var(--w); background: linear-gradient(90deg, #ffd56b, var(--arx-gold)); border-radius: 99px; animation: arxFill .6s var(--arx-ease) both; animation-delay: .35s; }
+.drv b { text-align: right; font-variant-numeric: tabular-nums; }
+.ins-state-title { margin: 2px 0 6px; font-size: 1.3rem; color: #fff; } .ins-state-sub { margin: 0; max-width: 62ch; line-height: 1.55; color: rgba(255,255,255,.85); }
+.scan-line { font-size: 1.05rem; font-weight: 700; min-height: 1.6em; } .scan-text.swap { animation: arxRise .3s var(--arx-ease); }
+.scan-bar { height: 8px; border-radius: 99px; background: rgba(255,255,255,.15); overflow: hidden; margin: 10px 0 12px; max-width: 520px; position: relative; }
+.scan-bar span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #ffd56b, var(--arx-gold)); border-radius: 99px; }
+.scan-bar::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(255,255,255,.45), transparent); width: 40%; animation: arxSweep 1.1s linear infinite; }
+@keyframes arxSweep { from { transform: translateX(-100%); } to { transform: translateX(260%); } }
+.scan-steps { display: flex; gap: 6px; } .scan-steps i { width: 26px; height: 4px; border-radius: 4px; background: rgba(255,255,255,.2); transition: background .25s; } .scan-steps i.on { background: var(--arx-gold); }
+
+/* ---------- Motion on the original sections (layout untouched) ---------- */
+.ar-grade-group { animation: arxRise .34s var(--arx-ease) both; animation-delay: calc(var(--i, 0) * 60ms); }
+.ar-grade-body, .ar-section-body, .ar-class-body { animation: arxRise .28s var(--arx-ease) both; }
+table.ar-table tbody tr { animation: arxRise .3s var(--arx-ease) both; animation-delay: calc(var(--r, 0) * 35ms); }
+.metric-bar span { animation: arxFill .6s var(--arx-ease) both; }
+.risk-pill.high i { border-radius: 50%; animation: arxPulse 2s ease-out infinite; }
+.risk-pill { transition: transform .15s var(--arx-ease); } tr:hover .risk-pill { transform: scale(1.05); }
+.ar-chip { transition: transform .15s var(--arx-ease); } .ar-chip:hover { transform: translateY(-1px); }
+.ai-btn { transition: transform .12s var(--arx-ease), box-shadow .18s, background .15s; } .ai-btn:not(:disabled):hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(27,67,50,.2); }
+
+/* ---------- AI modal: Uriel + staged reveal ---------- */
+.ai-modal-overlay.open { animation: arxFade .22s ease both; }
+.ai-modal-overlay.open .ai-modal { animation: arxModal .3s var(--arx-ease) both; }
+@keyframes arxFade { from { opacity: 0; } to { opacity: 1; } }
+@keyframes arxModal { from { opacity: 0; transform: translateY(16px) scale(.98); } to { opacity: 1; transform: none; } }
+.ai-modal-head { align-items: center; border-bottom: 3px solid var(--arx-gold); background: linear-gradient(135deg, #f4faf6, #fff); }
+.ai-modal-mascot { width: 46px; height: 46px; border-radius: 50%; object-fit: cover; object-position: center 35%; border: 2px solid var(--arx-gold); background: #fbf3dc; flex: 0 0 auto; }
+.ai-modal-titles { flex: 1; min-width: 0; }
+.ai-loading { display: flex; flex-direction: column; align-items: center; gap: 4px; }
+.ai-loading .uriel { margin-bottom: 8px; } .ai-loading .uriel + i { display: none; }
+
+/* ---------- Responsive ---------- */
+@media (max-width: 1100px) { .ins-grid { grid-template-columns: 1fr; } }
+@media (max-width: 720px) {
+    .ins-inner { grid-template-columns: 1fr; gap: 10px; padding: 18px 16px; }
+    .ins-mascot { position: absolute; top: 16px; right: 16px; padding: 0; z-index: 2; } .uriel.lg { --sz: 58px; }
+    .ins-head { padding-right: 76px; min-height: 58px; } .ins-again { margin-left: 0; }
+    .ar-insight::after { display: none; }
+}
+@media (max-width: 420px) { .drv { grid-template-columns: minmax(80px, auto) 1fr 20px; } .ins-row p.ins-big { font-size: 1.02rem; } }
+
+/* ---------- Respect reduced motion ---------- */
+@media (prefers-reduced-motion: reduce) {
+    .ar-wrap *, .ai-modal-overlay, .ai-modal-overlay * { animation-duration: .001ms !important; animation-iteration-count: 1 !important; animation-delay: 0ms !important; transition-duration: .001ms !important; }
+    .arx-seq { opacity: 1; }
+}
