+        }
+    };
+    function lang() { return document.documentElement.getAttribute('lang') === 'tl' ? 'tl' : 'en'; }
+    function t(k, v) {
+        var s = (TXT[lang()][k] !== undefined) ? TXT[lang()][k] : TXT.en[k];
+        if (v) Object.keys(v).forEach(function (x) { s = s.split('{' + x + '}').join(v[x]); });
