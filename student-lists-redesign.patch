diff --git a/public/student/assets/css/course_view.css b/public/student/assets/css/course_view.css
index fc35fa0..dd983e5 100644
--- a/public/student/assets/css/course_view.css
+++ b/public/student/assets/css/course_view.css
@@ -1670,3 +1670,224 @@
     .quiz-fact, .quiz-schedule__item { white-space: normal; padding: 6px 10px; line-height: 1.3; }
     .quiz-facts--detail { justify-content: flex-start; }
 }
+
+
+/* ========================================================== */
+/* ==========================================================
+   Assignment & Quiz lists — modern cards
+   Same design as the teacher side (teacher/assets/css/class_overview.css)
+   ========================================================== */
+.work-list {
+    list-style: none;
+    margin: 0;
+    padding: 0;
+    display: grid;
+    gap: 14px;
+}
+
+.work-card {
+    --wc-accent: var(--accent, #f4a300);
+    --wc-accent-soft: rgba(244, 163, 0, 0.14);
+    position: relative;
+    display: grid;
+    grid-template-columns: auto minmax(0, 1fr) auto;
+    align-items: center;
+    gap: 18px;
+    padding: 18px 20px 18px 22px;
+    background: var(--card, #fff);
+    border: 1px solid var(--border, #e3e9e6);
+    border-radius: var(--radius, 14px);
+    box-shadow: var(--shadow, 0 2px 10px rgba(16, 40, 30, 0.06));
+    overflow: hidden;
+    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
+}
+.work-card::before {                      /* colored accent rail */
+    content: "";
+    position: absolute;
+    inset: 0 auto 0 0;
+    width: 4px;
+    background: var(--wc-accent);
+}
+.work-card:hover {
+    transform: translateY(-2px);
+    border-color: var(--wc-accent);
+    box-shadow: 0 10px 26px rgba(16, 40, 30, 0.10);
+}
+.work-card--quiz {
+    --wc-accent: var(--primary-light, #2d6a4f);
+    --wc-accent-soft: rgba(45, 106, 79, 0.12);
+}
+.work-card.is-overdue { --wc-accent: var(--danger, #d64545); }
+
+.work-card__icon {
+    width: 48px;
+    height: 48px;
+    display: grid;
+    place-items: center;
+    border-radius: 14px;
+    background: var(--wc-accent-soft);
+    color: var(--wc-accent);
+    font-size: 1.15rem;
+    flex-shrink: 0;
+}
+.work-card--assignment .work-card__icon { color: var(--warn, #e07a1f); }
+.work-card--quiz .work-card__icon { color: var(--primary-light, #2d6a4f); }
+
+.work-card__main { min-width: 0; display: flex; flex-direction: column; gap: 10px; }
+
+.work-card__top {
+    display: flex;
+    align-items: center;
+    flex-wrap: wrap;
+    gap: 8px 10px;
+}
+.work-card__title {
+    min-width: 0;
+    font-size: 1rem;
+    font-weight: 700;
+    line-height: 1.35;
+    color: var(--text, #1c2b24);
+    text-decoration: none;
+    overflow-wrap: anywhere;
+    transition: color 0.15s ease;
+}
+.work-card__title:hover { color: var(--primary-light, #2d6a4f); }
+
+.work-tag {
+    display: inline-flex;
+    align-items: center;
+    padding: 3px 10px;
+    border-radius: 999px;
+    background: var(--wc-accent-soft);
+    color: var(--primary, #1b4332);
+    font-size: 0.7rem;
+    font-weight: 700;
+    letter-spacing: 0.03em;
+    text-transform: uppercase;
+    white-space: nowrap;
+}
+
+/* meta pills */
+.work-meta { display: flex; flex-wrap: wrap; gap: 8px; }
+.work-pill {
+    display: inline-flex;
+    align-items: center;
+    gap: 7px;
+    padding: 5px 11px;
+    border-radius: 999px;
+    background: var(--bg, #f4f7f5);
+    border: 1px solid var(--border, #e3e9e6);
+    color: var(--text-muted, #6b7d74);
+    font-size: 0.78rem;
+    line-height: 1.2;
+    white-space: nowrap;
+}
+.work-pill i { font-size: 0.72rem; color: var(--primary-light, #2d6a4f); }
+.work-pill b { color: var(--text, #1c2b24); font-weight: 600; }
+.work-pill--soft { background: transparent; }
+.work-pill--overdue {
+    background: #fdeceb;
+    border-color: #f6c9c6;
+    color: var(--danger, #d64545);
+}
+.work-pill--overdue i,
+.work-pill--overdue b { color: var(--danger, #d64545); }
+
+/* graded progress */
+.work-progress { display: flex; align-items: center; gap: 12px; max-width: 420px; }
+.work-progress__bar {
+    flex: 1;
+    height: 7px;
+    border-radius: 999px;
+    background: var(--border, #e3e9e6);
+    overflow: hidden;
+}
+.work-progress__bar span {
+    display: block;
+    height: 100%;
+    border-radius: inherit;
+    background: linear-gradient(90deg, var(--primary-light, #2d6a4f), var(--ok, #2d9d63));
+    transition: width 0.5s ease;
+}
+.work-progress__label {
+    font-size: 0.76rem;
+    color: var(--text-muted, #6b7d74);
+    white-space: nowrap;
+}
+.work-progress__label b { color: var(--text, #1c2b24); }
+
+/* actions */
+.work-card__actions { display: flex; align-items: center; gap: 8px; }
+.work-card__actions .material-delete-form { margin: 0; }
+.work-btn {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    padding: 9px 14px;
+    font-size: 0.82rem;
+    white-space: nowrap;
+    text-decoration: none;
+}
+.work-card__actions .qa-btn { width: 36px; height: 36px; border-radius: 10px; }
+
+/* ---------- Tablet ---------- */
+@media (max-width: 900px) {
+    .work-card {
+        grid-template-columns: auto minmax(0, 1fr);
+        row-gap: 14px;
+    }
+    .work-card__actions {
+        grid-column: 1 / -1;
+        padding-top: 14px;
+        border-top: 1px dashed var(--border, #e3e9e6);
+    }
+    .work-card__actions .work-btn { flex: 1; justify-content: center; }
+}
+
+/* ---------- Phone ---------- */
+@media (max-width: 640px) {
+    .work-list { gap: 12px; }
+    .work-card {
+        padding: 14px 14px 14px 18px;
+        gap: 12px;
+    }
+    .work-card__icon { width: 40px; height: 40px; font-size: 1rem; border-radius: 12px; }
+    /* icon sits beside the title on phones */
+    .work-card__main { display: contents; }
+    .work-card { grid-template-columns: 40px minmax(0, 1fr); align-items: start; }
+    .work-card__top { grid-column: 2; align-self: center; }
+    .work-meta, .work-progress { grid-column: 1 / -1; }
+    .work-meta { gap: 6px; }
+    .work-pill { white-space: normal; padding: 5px 10px; font-size: 0.74rem; }
+    .work-progress { max-width: none; }
+    .work-card__actions { grid-column: 1 / -1; }
+    .work-card__actions .qa-btn { width: 42px; height: 42px; }
+    .work-btn { padding: 11px 14px; }
+
+}
+@media (max-width: 380px) {
+    .work-btn i { display: none; }
+}
+
+
+
+/* ---------- Student-only additions ---------- */
+.work-card.is-locked { opacity: .92; }
+.work-card.is-locked .work-card__title { color: var(--text-muted, #6b7280); }
+.work-card.is-done { --wc-accent: var(--ok, #22c55e); }
+.work-card--assignment.is-done .work-card__icon { color: var(--ok, #22c55e); }
+.work-pill--score { font-weight: 700; }
+.work-pill--good { background: #e6f7ee; border-color: #bfe8d0; color: #0a7a3d; }
+.work-pill--mid  { background: #fff6e0; border-color: #f5dfa5; color: #a16207; }
+.work-pill--low  { background: #fdeceb; border-color: #f6c9c6; color: #b3261e; }
+.work-pill--good i, .work-pill--good b,
+.work-pill--mid i,  .work-pill--mid b,
+.work-pill--low i,  .work-pill--low b { color: inherit; }
+.work-btn--disabled { opacity: .6; cursor: not-allowed; pointer-events: none; }
+.work-card__actions .btn-primary.work-btn { border: 0; }
+.work-card__actions { flex-wrap: wrap; }
+.work-card__title--static { cursor: default; }
+.work-card__title--static:hover { color: var(--text, #1f2937); }
+@media (max-width: 640px) {
+    .work-card__actions .work-btn { flex: 1 1 120px; justify-content: center; }
+}
